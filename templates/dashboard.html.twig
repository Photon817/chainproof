{% extends 'base.html.twig' %}

{% block title %}ChainProof · Don't trust the LLM{% endblock %}

{% block body %}
{% set node = health.node %}
{% set forge = health.toolchain.forge %}
{% set cast = health.toolchain.cast %}

<section class="hero">
    <div class="hero-copy">
        <div class="kicker"><span class="pulse"></span> PHP2Shell 范式 · 平移到 Solidity</div>
        <h1>Don't trust the LLM.<br><span class="gradient">Prove it on-chain.</span></h1>
        <p class="lede">
            一个 Agent 扮演攻击者，寻找重入与访问控制缺陷；另一个 Agent 扮演审查者，负责驳回站不住脚的声明。
            只有 Foundry/Anvil 上真实广播、真实回执、真实余额变化，才会被标记为
            <strong>proven</strong>。
        </p>
        <div class="hero-actions">
            <a class="btn btn-ghost" href="#launch">启动一次审计</a>
            <a class="btn btn-quiet" href="#how">它是怎么工作的</a>
        </div>
    </div>
    <div class="hero-orbit" aria-hidden="true">
        <div class="orbit-ring"></div>
        <div class="orbit-ring ring-2"></div>
        <div class="orbit-core">
            <span class="core-label">FOUNDRY</span>
            <span class="core-sub">final judge</span>
        </div>
        <div class="orbit-chip chip-a">ATTACKER</div>
        <div class="orbit-chip chip-b">REVIEWER</div>
        <div class="orbit-chip chip-c">ANVIL 31337</div>
    </div>
</section>

<div class="status-strip">
    <div class="status-item">
        <span class="status-dot {{ health.llm_mode == 'live' ? 'dot-violet' : 'dot-cyan' }}"></span>
        <span>Agent 模式</span>
        <strong>{{ health.llm_mode }}</strong>
        <small>{{ health.llm_mode == 'mock' ? '确定性演示，无需 API Key' : health.llm_model }}</small>
    </div>
    <div class="status-item">
        <span class="status-dot {{ node.reachable ? 'dot-green' : 'dot-red' }}"></span>
        <span>Anvil</span>
        <strong>{{ node.reachable ? 'reachable' : 'offline' }}</strong>
        <small>{{ node.reachable ? 'chain ' ~ node.chain_id ~ ' · block ' ~ (node.block_number ?? '-') : 'docker compose up -d anvil' }}</small>
    </div>
    <div class="status-item">
        <span class="status-dot {{ forge ? 'dot-green' : 'dot-red' }}"></span>
        <span>Forge</span>
        <strong>{{ forge ? 'ready' : 'missing' }}</strong>
        <small>{{ forge ? forge|slice(0, 46) : 'foundryup / docker compose build' }}</small>
    </div>
    <div class="status-item">
        <span class="status-dot {{ health.has_llm_key ? 'dot-green' : 'dot-amber' }}"></span>
        <span>LLM Key</span>
        <strong>{{ health.has_llm_key ? 'loaded' : 'not set' }}</strong>
        <small>{{ health.has_llm_key ? 'live 模式可用' : 'mock 模式仍然完整可用' }}</small>
    </div>
</div>

<section class="panel launch-panel" id="launch">
    <div class="panel-head">
        <div>
            <div class="kicker">RUN AN AUDIT</div>
            <h2>把一个合约交给对抗循环</h2>
        </div>
        <div class="panel-note">目标限定在 <code>foundry/src</code> · 只连接本地 Anvil</div>
    </div>

    {% if targets is empty %}
        <div class="empty">还没有靶场合约。把 <code>.sol</code> 放进 <code>foundry/src</code> 后刷新。</div>
    {% else %}
    <form class="launch-form" method="post" action="{{ path('audit_launch') }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">

        <label class="field">
            <span>目标合约</span>
            <select name="target">
                {% for target in targets %}
                    <option value="{{ target.file }}">{{ target.file }} · {{ target.contract }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="field">
            <span>Agent 模式</span>
            <select name="mode">
                <option value="mock" {{ default_mode == 'mock' ? 'selected' }}>mock · deterministic</option>
                <option value="live" {{ default_mode == 'live' ? 'selected' }}>live · OpenAI-compatible</option>
            </select>
        </label>

        <label class="check">
            <input type="checkbox" name="bounty" value="1" checked>
            <span>触发赏金结算</span>
        </label>

        <label class="check">
            <input type="checkbox" name="poc" value="1" checked>
            <span>执行 Foundry PoC</span>
        </label>

        <button class="btn btn-primary" type="submit">启动对抗审计</button>
    </form>
    {% endif %}
</section>

<section class="section" id="how">
    <div class="section-head">
        <div class="kicker">THE ADVERSARIAL LOOP</div>
        <h2>四个角色，一条证据链</h2>
        <p>把 symfony-security-auditor 的攻击者-审查者循环平移到 Solidity，把 AIxVuln 的沙箱执行换成 Foundry/Anvil。</p>
    </div>
    <div class="loop-grid">
        <article class="loop-card">
            <span class="loop-index">01</span>
            <h3>Surface</h3>
            <p>正则提取合约、函数、状态变量与行号；静态预扫描给出重入与权限证据标记。</p>
            <code>SurfaceExtractor</code>
        </article>
        <article class="loop-card">
            <span class="loop-index">02</span>
            <h3>Attacker</h3>
            <p>只收窄到重入与访问控制；输出类型化 <code>AttackPlan</code>，不直接生成 Solidity。</p>
            <code>AttackerAgent</code>
        </article>
        <article class="loop-card">
            <span class="loop-index">03</span>
            <h3>Reviewer</h3>
            <p>默认怀疑：检查外部可达性、nonReentrant、onlyOwner、CEI 顺序与正收益。</p>
            <code>ReviewerAgent</code>
        </article>
        <article class="loop-card loop-card-accent">
            <span class="loop-index">04</span>
            <h3>Foundry</h3>
            <p>部署全新靶场、注入受害者资金、广播真实交易、读取回执与余额差。</p>
            <code>FoundryRunner</code>
        </article>
    </div>
</section>

<section class="section" id="targets">
    <div class="section-head">
        <div class="kicker">SANDBOX TARGETS</div>
        <h2>可审计的靶场</h2>
        <p>每个目标都带明确预期：哪些应该被证明，哪个应该被 Reviewer 驳回。</p>
    </div>
    <div class="target-grid">
        {% for target in targets %}
            <article class="target-card">
                <div class="target-top">
                    <code>{{ target.file }}</code>
                    <span class="badge badge-{{ target.expected }}">{{ target.expected }}</span>
                </div>
                <h3>{{ target.contract }}</h3>
                <p>{{ target.description }}</p>
                <div class="target-meta">
                    <span>seed {{ target.seed_eth }} ETH</span>
                    <span>local only</span>
                </div>
            </article>
        {% else %}
            <div class="empty">还没有靶场。</div>
        {% endfor %}
    </div>
</section>

<section class="section">
    <div class="section-head section-head-row">
        <div>
            <div class="kicker">RECENT RUNS</div>
            <h2>最近运行</h2>
        </div>
        <a class="btn btn-quiet" href="{{ path('dashboard') }}">刷新</a>
    </div>

    {% if runs is empty %}
        <div class="empty">还没有运行记录。启动第一次审计，Attacker 和 Reviewer 会在这里留下完整的事件流。</div>
    {% else %}
    <div class="table-wrap">
        <table class="runs-table">
            <thead>
            <tr>
                <th>Run ID</th>
                <th>目标</th>
                <th>状态</th>
                <th>发现 / 已验证</th>
                <th>链上提取</th>
                <th>创建时间</th>
            </tr>
            </thead>
            <tbody>
            {% for run in runs %}
                <tr>
                    <td><a class="mono-link" href="{{ path('run_show', {id: run.id}) }}">{{ run.id }}</a></td>
                    <td>{{ run.target }}</td>
                    <td><span class="badge badge-{{ run.status }}">{{ run.status }}</span></td>
                    <td>{{ run.stats.findings }} / <strong>{{ run.stats.proven }}</strong></td>
                    <td>{{ run.stats.extracted_eth }} ETH</td>
                    <td class="muted">{{ run.created_at }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
