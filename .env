# ---------------------------------------------------------------------------
# ChainProof — default local configuration
# ---------------------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=chainproof-local-dev-secret-change-me

# mock = deterministic agents, no API key needed (demo-safe)
# live = OpenAI-compatible chat completions endpoint
APP_LLM_MODE=mock
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-chat
APP_LLM_JSON_MODE=1

# Local Anvil (docker compose overrides ANVIL_RPC_URL with http://anvil:8545)
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337

